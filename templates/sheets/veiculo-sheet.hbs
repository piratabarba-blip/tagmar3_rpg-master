<form class="tv-form form_tagmar" autocomplete="off">
<header class="sheet-header tv-v-header">
  <div class="container_dados tv-v-brand"><img class="tagmarLogo" src="{{systemPath}}/templates/sheets/img/logo.png" alt="Tagmar"><h1 class="fairyDust" title="Adaptação extraoficial — veículos e máquinas">Veículo / Máquina</h1></div>
  <div class="container_dados tagmar-identity tv-v-identity">
    <div class="tagmar-portrait-cell">{{#if portraitIsVideo}}<video class="tagmar-portrait" src="{{portraitSrc}}" autoplay loop muted playsinline preload="metadata" {{#if editable}}role="button" tabindex="0"{{/if}} title="Alterar retrato"></video>{{else}}<img class="tagmar-portrait" src="{{portraitSrc}}" data-edit="img" alt="{{actor.name}}" title="Alterar retrato" {{#if editable}}role="button" tabindex="0"{{/if}}>{{/if}}</div>
    <div class="tagmar-name"><h1 class="fairyDust"><input name="name" type="text" value="{{actor.name}}" aria-label="Nome do veículo"></h1>{{#unless system.absorcao.value}}<div class="tv-v-status">Inoperante — sem ABS</div>{{/unless}}</div>
  </div>
</header>
<section class="container_dados tv-v-body">
<nav class="prim-tabs tabs" data-group="primary"><label class="mediaeval"><a class="item" data-tab="basico">Básico</a></label><label class="mediaeval"><a class="item" data-tab="combate">Combate</a></label><label class="mediaeval"><a class="item" data-tab="pertences">Pertences</a></label><label class="mediaeval"><a class="item" data-tab="biografia">Biografia</a></label></nav>
<section class="sheet-primary">
<div class="tab" data-group="primary" data-tab="basico">
  <div class="tv-grid tv-v-two"><label class="tv-field">Categoria<select name="system.categoria">{{selectOptions categories selected=system.categoria}}</select></label><label class="tv-field">Propulsão<select name="system.propulsao">{{selectOptions propulsion selected=system.propulsao}}</select></label></div>
  <div class="tv-v-groups">
    <section class="tv-v-group"><h3 class="mediaeval">Velocidade / Iniciativa</h3><div class="tv-grid tv-v-two"><label class="tv-field">V.Base <span class="tv-help" tabindex="0" title="Mesma unidade das outras fichas. Não depende automaticamente do número de animais ou do vento." aria-label="Mesma unidade das outras fichas. Não depende automaticamente do número de animais ou do vento.">?</span><input name="system.vb" type="number" data-dtype="Number" step="any" value="{{system.vb}}"></label><label class="tv-field">Iniciativa<input name="system.iniciativa" type="number" data-dtype="Number" step="any" value="{{system.iniciativa}}"></label></div></section>
    <section class="tv-v-group"><h3 class="mediaeval">Tripulação / Passageiros</h3><div class="tv-grid tv-v-three"><label class="tv-field">Mínima <span class="tv-help" tabindex="0" title="Equipe mínima para manobrar. A tripulação atual também é comparada com a equipe mínima de cada arma." aria-label="Equipe mínima para manobrar; cada arma tem seus operadores.">?</span><input name="system.tripulacao.minima" type="number" data-dtype="Number" step="any" value="{{system.tripulacao.minima}}"></label><label class="tv-field">Atual<input name="system.tripulacao.atual" type="number" data-dtype="Number" step="any" value="{{system.tripulacao.atual}}"></label><label class="tv-field">Passageiros <span class="tv-help" tabindex="0" title="Capacidade de passageiros." aria-label="Capacidade de passageiros.">?</span><input name="system.passageiros" type="number" data-dtype="Number" step="any" value="{{system.passageiros}}"></label></div></section>
    <section class="tv-v-group"><h3 class="mediaeval">Defesa</h3><div class="tv-grid tv-v-two"><label class="tv-field">Cat. <span class="tv-help" tabindex="0" title="Categoria usada na tabela de ataque." aria-label="Categoria usada na tabela de ataque.">?</span><select name="system.d_ativa.categoria">{{selectOptions defenses selected=system.d_ativa.categoria}}</select></label><label class="tv-field">Valor <span class="tv-help" tabindex="0" title="Defesa da estrutura, sem esquiva pessoal automática." aria-label="Defesa da estrutura, sem esquiva pessoal automática.">?</span><input name="system.d_ativa.valor" type="number" data-dtype="Number" step="any" value="{{system.d_ativa.valor}}"></label></div></section>
  </div>
  <section class="tv-v-group"><h3 class="mediaeval">Estrutura <span class="tv-help" tabindex="0" title="ABS é a reserva estrutural. Cada impacto perde ARM antes de reduzir ABS. Em zero, manobras e disparos ficam impedidos." aria-label="ABS é a reserva estrutural. Cada impacto perde ARM antes de reduzir ABS. Em zero, manobras e disparos ficam impedidos.">?</span></h3><div class="tv-v-structure"><div class="tv-grid tv-v-three"><label class="tv-field">ABS máxima<input name="system.absorcao.max" type="number" data-dtype="Number" step="any" value="{{system.absorcao.max}}"></label><label class="tv-field">ABS atual<input name="system.absorcao.value" type="number" data-dtype="Number" step="any" value="{{system.absorcao.value}}"></label><label class="tv-field">ARM <span class="tv-help" tabindex="0" title="Redução fixa por impacto: máximo entre zero e dano recebido menos ARM." aria-label="Redução fixa por impacto: máximo entre zero e dano recebido menos ARM.">?</span><input name="system.arm" type="number" data-dtype="Number" step="any" value="{{system.arm}}"></label></div><div class="tv-toolbar">{{#if isGM}}{{#if editable}}<button type="button" data-action="repair" >Reparar</button>{{/if}}{{/if}}</div></div></section>
  <section class="tv-v-group"><h3 class="mediaeval">Manobra <span class="tv-help" tabindex="0" title="Teste de Habilidade do sistema. O mestre compara a cor com a dificuldade da manobra. O ajuste da máquina altera colunas, não a VB." aria-label="Teste de Habilidade do sistema. O mestre compara a cor com a dificuldade da manobra. O ajuste da máquina altera colunas, não a VB.">?</span></h3>
    <div class="tv-v-origin"><label class="tv-field">Origem da manobra <span class="tv-help" tabindex="0" title="Total manual é reservado ao mestre. O vínculo consulta o total atual da habilidade." aria-label="Total manual é reservado ao mestre. O vínculo consulta o total atual da habilidade.">?</span><select name="system.manobra.modo">{{selectOptions modes selected=system.manobra.modo}}</select></label></div>{{{operatorEditorHTML}}}<div class="tv-v-manual"><label class="tv-field">Total manual <span class="tv-help" tabindex="0" title="Usado somente no modo manual; informe o total final da equipe." aria-label="Usado somente no modo manual; informe o total final da equipe.">?</span><input name="system.manobra.totalManual" {{#unless manualOperator}}disabled{{/unless}} type="number" data-dtype="Number" step="any" value="{{system.manobra.totalManual}}"></label><label class="tv-field">Ajuste da máquina <span class="tv-help" tabindex="0" title="Modificador em colunas, somado ao total do operador treinado." aria-label="Modificador em colunas, somado ao total do operador treinado.">?</span><input name="system.manobra.ajuste" type="number" data-dtype="Number" step="any" value="{{system.manobra.ajuste}}"></label><label class="tv-field">Bônus/Penalidade<input name="system.manobra.ajusteCircunstancial" type="number" data-dtype="Number" value="{{system.manobra.ajusteCircunstancial}}"></label> {{#if editable}}<button type="button" data-action="maneuver" >Testar manobra</button>{{/if}}</div>
  </section>
  <section class="tv-v-group"><h3 class="mediaeval">Resistências</h3><div class="tv-v-resistance"><label class="tv-check"><input type="checkbox" name="system.resistenciasAtivas" {{checked system.resistenciasAtivas}}> Habilitar <span class="tv-help" tabindex="0" title="O mestre decide se RF/RM se aplicam ao material ou ao efeito. Não concede imunidades." aria-label="O mestre decide se RF/RM se aplicam ao material ou ao efeito. Não concede imunidades.">?</span></label>{{#if system.resistenciasAtivas}}<label class="tv-field">Física<input name="system.rf" type="number" data-dtype="Number" step="any" value="{{system.rf}}"></label><label class="tv-field">Magia<input name="system.rm" type="number" data-dtype="Number" step="any" value="{{system.rm}}"></label><div class="tv-toolbar">{{#if editable}}<button type="button" data-action="rf" >Testar RF</button>{{/if}}{{#if editable}}<button type="button" data-action="rm" >Testar RM</button>{{/if}}</div>{{/if}}</div></section>
</div>
<div class="tab" data-group="primary" data-tab="combate">
<div class="tv-attack-settings">
 <label>Def. Oponente:<select name="system.inf_ataque.cat_def">{{selectOptions defenses selected=attackSettings.cat_def}}</select></label>
 <label>Valor:<input type="number" name="system.inf_ataque.valor_def" data-dtype="Number" value="{{attackSettings.valor_def}}"></label>
 <label>Bônus/Penalidade:<input type="number" name="system.inf_ataque.bonus" data-dtype="Number" value="{{attackSettings.bonus}}"></label>
 {{#if editable}}<button type="button" data-action="target-defense" title="Copia a defesa do único alvo marcado no mapa.">Usar alvo</button>{{/if}}</div>

<div class="tv-toolbar tv-v-section-title">{{#if editable}}<a class="newCombat" data-action="weapon"><i class="fas fa-user-plus"></i>Add</a>{{/if}}<label class="tv-search">Procurar: <input type="search" data-vehicle-search placeholder="Digite para localizar o item."></label></div>
<table class="tv-v-table item-list"><colgroup><col><col style="width:60px"><col style="width:90px"><col style="width:35px"><col style="width:35px"><col style="width:35px"><col style="width:45px"><col style="width:60px"><col style="width:65px"></colgroup><thead><tr><th>Ataque</th><th>Munição</th><th>Alcance</th><th>L</th><th>M</th><th>P</th><th>100%</th><th title="Rodadas de referência; a mesa acompanha pelo combate. Não bloqueia disparos.">Recarga</th><th>Editar</th></tr></thead><tbody>{{#each weapons}}<tr class="item" data-item-id="{{id}}"><td class="tv-v-item-name"><img class="imgItem" src="{{img}}" alt=""><a class="rollable" {{#if ../editable}}data-action="attack" role="button" tabindex="0"{{/if}} title="Clique para atacar ou arraste para sua barra de macros. Equipe {{crew}} · {{status}}">{{name}}</a></td><td>{{ammo}}</td><td>{{range}}</td><td>{{l}}</td><td>{{m}}</td><td>{{p}}</td><td>{{damage}}</td><td>{{reload}}</td><td>{{#if ../editable}}<div class="item-controls"><a class="item-control item-copy" data-action="copy" title="Duplicar"><i class="fas fa-copy"></i></a><a class="item-control item-edit" data-action="edit" title="Editar"><i class="fas fa-edit"></i></a><a class="item-control item-delete" data-action="remove" title="Remover"><i class="fas fa-trash"></i></a></div>{{/if}}</td></tr><tr class="tv-weapon-config" data-item-id="{{id}}" data-weapon-operator="{{id}}"><td colspan="9">
 <div class="tv-weapon-origin"><label>Origem do ataque:<select data-weapon-field="operacao.modo" {{#unless ../editable}}disabled{{/unless}}>{{selectOptions ../modes selected=mode}}</select></label>
 {{#if isManual}}<label>Total manual:<input type="number" data-weapon-field="operacao.totalManual" value="{{manualTotal}}" {{#unless ../isGM}}disabled{{/unless}}></label>{{/if}}</div>
 {{{operatorEditorHTML}}}</td></tr>{{else}}<tr><td colspan="9" class="tv-empty">Arraste uma Arma de Guerra ou clique em Add.</td></tr>{{/each}}</tbody></table>
</div>
<div class="tab" data-group="primary" data-tab="pertences">
  <section class="tv-v-group"><h3 class="mediaeval">Carga <span class="tv-help" tabindex="0" title="Soma armas, pertences (peso × quantidade) e carga adicional. Pesos ausentes contam como zero. Excesso não aplica penalidade automática." aria-label="Soma armas, pertences (peso × quantidade) e carga adicional. Pesos ausentes contam como zero. Excesso não aplica penalidade automática.">?</span></h3><div class="tv-grid tv-v-three"><label class="tv-field">Capacidade (kg)<input name="system.carga.max" type="number" data-dtype="Number" step="any" value="{{system.carga.max}}"></label><label class="tv-field">Adicional (kg) <span class="tv-help" tabindex="0" title="Carga que não está representada nos itens." aria-label="Carga que não está representada nos itens.">?</span><input name="system.cargaExtra" type="number" data-dtype="Number" step="any" value="{{system.cargaExtra}}"></label><label class="tv-field">Peso total (kg)<input value="{{cargoWeight}}" readonly aria-label="Peso total"></label></div>{{#if overloaded}}<div class="tv-v-warning">Acima da capacidade de carga.</div>{{/if}}</section>
  <div class="tv-toolbar tv-v-section-title">{{#if editable}}<a class="newPertence" data-action="belonging"><i class="fas fa-user-plus"></i>Add</a>{{/if}}<label class="tv-search">Procurar: <input type="search" data-vehicle-search placeholder="Digite para localizar o item."></label></div>
<table class="tv-v-table item-list"><colgroup><col><col style="width:85px"><col style="width:75px"><col style="width:75px"><col style="width:55px"><col style="width:55px"></colgroup><thead><tr><th>Pertence</th><th>Quantidade</th><th>Peso(Kg)</th><th>Total(Kg)</th><th>Mover</th><th>Editar</th></tr></thead><tbody>{{#each cargo}}<tr class="item" data-item-id="{{id}}"><td class="tv-v-item-name pertenceName"><img class="imgItem" src="{{img}}" alt="">{{name}}</td><td>{{quantity}}</td><td>{{weight}}</td><td>{{total}}</td><td>{{#if ../editable}}<a class="movePertence" data-action="move" data-item-id="{{id}}" title="Mover para Transporte"><i class="fas fa-horse"></i></a>{{/if}}</td><td>{{#if ../editable}}<div class="item-controls"><a class="item-control item-edit" data-action="edit" title="Editar"><i class="fas fa-edit"></i></a><a class="item-control item-delete" data-action="remove" title="Remover"><i class="fas fa-trash"></i></a></div>{{/if}}</td></tr>{{else}}<tr><td colspan="6" class="tv-empty">Nenhum pertence nesta lista.</td></tr>{{/each}}</tbody></table>
{{#if transports}}<h3 class="mediaeval">Transportes auxiliares</h3><table class="tv-v-table item-list"><thead><tr><th>Transporte</th><th>Cap.Carga(Kg)</th><th>Cap.Pessoas</th><th>Editar</th></tr></thead><tbody>{{#each transports}}<tr class="item" data-item-id="{{id}}"><td class="tv-v-item-name">{{name}}</td><td>{{capacity}}</td><td>{{people}}</td><td>{{#if ../editable}}<div class="item-controls"><a class="item-control item-copy" data-action="copy" title="Duplicar"><i class="fas fa-copy"></i></a><a class="item-control item-edit" data-action="edit" title="Editar"><i class="fas fa-edit"></i></a><a class="item-control item-delete" data-action="remove" title="Remover"><i class="fas fa-trash"></i></a></div>{{/if}}</td></tr>{{/each}}</tbody></table>{{/if}}
{{#if transportedCargo}}<table class="tv-v-table item-list"><colgroup><col><col style="width:85px"><col style="width:75px"><col style="width:75px"><col style="width:55px"><col style="width:55px"></colgroup><thead><tr><th>Pertence em Transporte</th><th>Quantidade</th><th>Peso(Kg)</th><th>Total(Kg)</th><th>Mover</th><th>Editar</th></tr></thead><tbody>{{#each transportedCargo}}<tr class="item" data-item-id="{{id}}"><td class="tv-v-item-name pertenceName"><img class="imgItem" src="{{img}}" alt="">{{name}}</td><td>{{quantity}}</td><td>{{weight}}</td><td>{{total}}</td><td>{{#if ../editable}}<a class="movePertence" data-action="move" data-item-id="{{id}}" title="Mover para o veículo"><i class="fas fa-ship"></i></a>{{/if}}</td><td>{{#if ../editable}}<div class="item-controls"><a class="item-control item-edit" data-action="edit" title="Editar"><i class="fas fa-edit"></i></a><a class="item-control item-delete" data-action="remove" title="Remover"><i class="fas fa-trash"></i></a></div>{{/if}}</td></tr>{{else}}<tr><td colspan="6" class="tv-empty">Nenhum pertence nesta lista.</td></tr>{{/each}}</tbody></table>{{/if}}
</div>
<div class="tab tv-v-biography" data-group="primary" data-tab="biografia">
  {{editor biographyHTML target="system.notas" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
</div>
</section><footer class="tv-v-footer">Veículos e armas de guerra · adaptação extraoficial</footer>
</section></form>
