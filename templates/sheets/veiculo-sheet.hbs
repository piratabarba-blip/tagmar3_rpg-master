<nav class="prim-tabs tabs" data-group="primary"><label class="mediaeval"><a class="item" data-tab="basico">Básico</a></label><label class="mediaeval"><a class="item" data-tab="combate">Combate</a></label><label class="mediaeval"><a class="item" data-tab="pertences">Pertences</a></label><label class="mediaeval"><a class="item" data-tab="biografia">Biografia</a></label></nav>
<section class="sheet-primary">
<div class="tab" data-group="primary" data-tab="basico"><div class="tc-type-row"><label>Categoria<select name="system.categoria">{{selectOptions categories selected=system.categoria}}</select><span class="tv-help" tabindex="0" title="Classificação do veículo ou máquina." aria-label="Classificação do veículo ou máquina.">?</span></label><label>Propulsão<select name="system.propulsao">{{selectOptions propulsion selected=system.propulsao}}</select><span class="tv-help" tabindex="0" title="Como se move; o tipo não recalcula a VB." aria-label="Como se move; o tipo não recalcula a VB.">?</span></label></div><div class="tc-columns"><div><section class="tv-v-group tc-group "><h3 class="fairyDust">Estrutura e defesa </h3><table class="tc-stats"><tbody><tr><th scope="row">ABS máxima <span class="tv-help" tabindex="0" title="Resistência estrutural total, definida pela mesa." aria-label="Resistência estrutural total, definida pela mesa.">?</span></th><td class=""><input name="system.absorcao.max" type="number" data-dtype="Number" step="any" value="{{system.absorcao.max}}"></td></tr><tr><th scope="row">ABS atual <span class="tv-help" tabindex="0" title="Reserva restante. Em zero, o veículo fica inoperante; não tem EF/EH." aria-label="Reserva restante. Em zero, o veículo fica inoperante; não tem EF/EH.">?</span></th><td class=""><input name="system.absorcao.value" type="number" data-dtype="Number" step="any" value="{{system.absorcao.value}}"></td></tr><tr><th scope="row">ARM <span class="tv-help" tabindex="0" title="Redução fixa por impacto. Ex.: dano 18 e ARM 10 retiram 8 ABS; dano até 10 não reduz ABS." aria-label="Redução fixa por impacto. Ex.: dano 18 e ARM 10 retiram 8 ABS; dano até 10 não reduz ABS.">?</span></th><td class=""><input name="system.arm" type="number" data-dtype="Number" step="any" value="{{system.arm}}"></td></tr><tr><th scope="row">Categoria de defesa <span class="tv-help" tabindex="0" title="Categoria usada pelo atacante na tabela de resolução." aria-label="Categoria usada pelo atacante na tabela de resolução.">?</span></th><td class="tc-wide"><select name="system.d_ativa.categoria">{{selectOptions defenses selected=system.d_ativa.categoria}}</select></td></tr><tr><th scope="row">Valor da defesa <span class="tv-help" tabindex="0" title="Defesa estrutural, sem esquiva pessoal automática." aria-label="Defesa estrutural, sem esquiva pessoal automática.">?</span></th><td class=""><input name="system.d_ativa.valor" type="number" data-dtype="Number" step="any" value="{{system.d_ativa.valor}}"></td></tr></tbody></table>{{#if editable}}{{#if isGM}}<button type="button" data-action="repair">Reparar estrutura</button>{{/if}}{{/if}}</section></div><div><section class="tv-v-group tc-group "><h3 class="fairyDust">Movimento e tripulação </h3><table class="tc-stats"><tbody><tr><th scope="row">V.Base <span class="tv-help" tabindex="0" title="Mesma unidade das outras fichas. A mesa define o valor; vento e animais não alteram automaticamente." aria-label="Mesma unidade das outras fichas. A mesa define o valor; vento e animais não alteram automaticamente.">?</span></th><td class=""><input name="system.vb" type="number" data-dtype="Number" step="any" value="{{system.vb}}"></td></tr><tr><th scope="row">Iniciativa <span class="tv-help" tabindex="0" title="Valor de iniciativa cadastrado para a máquina." aria-label="Valor de iniciativa cadastrado para a máquina.">?</span></th><td class=""><input name="system.iniciativa" type="number" data-dtype="Number" step="any" value="{{system.iniciativa}}"></td></tr><tr><th scope="row">Tripulação mínima <span class="tv-help" tabindex="0" title="Mínimo para manobrar. Cada arma também possui seu requisito de equipe." aria-label="Mínimo para manobrar. Cada arma também possui seu requisito de equipe.">?</span></th><td class=""><input name="system.tripulacao.minima" type="number" data-dtype="Number" step="any" value="{{system.tripulacao.minima}}"></td></tr><tr><th scope="row">Tripulação atual <span class="tv-help" tabindex="0" title="Pessoas disponíveis. É comparado com o mínimo para manobrar e operar armas; não distribui pessoas automaticamente entre armas." aria-label="Pessoas disponíveis. É comparado com o mínimo para manobrar e operar armas; não distribui pessoas automaticamente entre armas.">?</span></th><td class=""><input name="system.tripulacao.atual" type="number" data-dtype="Number" step="any" value="{{system.tripulacao.atual}}"></td></tr><tr><th scope="row">Passageiros <span class="tv-help" tabindex="0" title="Capacidade de passageiros; não soma à tripulação disponível." aria-label="Capacidade de passageiros; não soma à tripulação disponível.">?</span></th><td class=""><input name="system.passageiros" type="number" data-dtype="Number" step="any" value="{{system.passageiros}}"></td></tr></tbody></table></section></div></div><section class="tv-v-group tc-group "><h3 class="fairyDust">Manobra </h3><div class="tv-v-origin"><label class="tv-field">Origem da manobra <span class="tv-help" tabindex="0" title="Vincule um personagem e escolha a habilidade adequada. Apenas o vínculo ativo fornece o total; não se somam os condutores." aria-label="Vincule um personagem e escolha a habilidade adequada. Apenas o vínculo ativo fornece o total; não se somam os condutores.">?</span><select name="system.manobra.modo">{{selectOptions modes selected=system.manobra.modo}}</select></label></div>{{{operatorEditorHTML}}}<div class="tc-maneuver-bottom"><table class="tc-stats"><tbody>{{#if manualOperator}}<tr><th scope="row">Total manual <span class="tv-help" tabindex="0" title="No modo manual, o mestre informa o total final da equipe." aria-label="No modo manual, o mestre informa o total final da equipe.">?</span></th><td class=""><input name="system.manobra.totalManual" {{#unless manualOperator}}disabled{{/unless}} type="number" data-dtype="Number" step="any" value="{{system.manobra.totalManual}}"></td></tr>{{/if}}<tr><th scope="row">Ajuste da máquina <span class="tv-help" tabindex="0" title="Modificador em colunas para o operador treinado; não altera a VB." aria-label="Modificador em colunas para o operador treinado; não altera a VB.">?</span></th><td class=""><input name="system.manobra.ajuste" type="number" data-dtype="Number" step="any" value="{{system.manobra.ajuste}}"></td></tr><tr><th scope="row">Bônus / penalidade <span class="tv-help" tabindex="0" title="Modificador circunstancial desta manobra." aria-label="Modificador circunstancial desta manobra.">?</span></th><td class=""><input name="system.manobra.ajusteCircunstancial" type="number" data-dtype="Number" value="{{system.manobra.ajusteCircunstancial}}"></td></tr></tbody></table><div>{{#if editable}}<button type="button" data-action="maneuver">Testar manobra</button>{{/if}}<p class="tc-caption">Compare a cor da rolagem com a dificuldade escolhida pelo mestre.</p></div></div></section><section class="tv-v-group tc-group "><h3 class="fairyDust">Resistências </h3><div class="tc-checks"><label class="tv-check"><input type="checkbox" name="system.resistenciasAtivas" {{checked system.resistenciasAtivas}}>Habilitar resistências <span class="tv-help" tabindex="0" title="Use apenas quando a mesa determinar que RF/RM se aplicam ao material ou efeito. Não concede imunidades." aria-label="Use apenas quando a mesa determinar que RF/RM se aplicam ao material ou efeito. Não concede imunidades.">?</span></label></div>{{#if system.resistenciasAtivas}}<table class="tc-stats"><tbody><tr><th scope="row">Física </th><td class=""><input name="system.rf" type="number" data-dtype="Number" step="any" value="{{system.rf}}"></td></tr><tr><th scope="row">Magia </th><td class=""><input name="system.rm" type="number" data-dtype="Number" step="any" value="{{system.rm}}"></td></tr></tbody></table><div class="tv-toolbar">{{#if editable}}<button type="button" data-action="rf">Testar RF</button>{{/if}}{{#if editable}}<button type="button" data-action="rm">Testar RM</button>{{/if}}</div>{{/if}}</section></div><div class="tab" data-group="primary" data-tab="combate">
