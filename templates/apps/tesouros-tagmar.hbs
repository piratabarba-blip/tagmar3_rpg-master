<form class="tesouros-tagmar-form">
  <nav class="tesouro-tabs tabs" data-group="primary">
    <a class="item" data-tab="gerar"><i class="fas fa-dice"></i> Itens aleatórios</a>
    <a class="item" data-tab="especificos"><i class="fas fa-pen-ruler"></i> Tesouros específicos</a>
  </nav>

  <section class="tesouro-body">
    <div class="tab" data-group="primary" data-tab="gerar">
      <div class="tesouro-generator-grid tesouro-compact-generator">
        <fieldset class="tesouro-classification-options">
          <legend>Sorteio de itens</legend>
          <label>O que gerar
            <select name="treasureMode">
              <option value="mixed">Itens variados</option>
              <option value="mundane">Somente itens mundanos</option>
              <option value="magical">Somente itens mágicos</option>
            </select>
          </label>
          <p class="notes" data-treasure-mode-note></p>
          <label data-mundane-option>Qualidade de fabricação
            <select name="mundaneQuality">
              <option value="">Padrão do objeto</option>
              <option value="Boa fabricação">Boa fabricação</option>
              <option value="Excelente fabricação">Excelente fabricação</option>
            </select>
          </label>
          <p class="notes" data-mundane-option>A qualidade é descritiva: não concede bônus mágico nem altera valores de combate.</p>
          <input type="hidden" name="generationMode" value="quick">
          <label>Tipo do tesouro
            <select name="treasureType">
              <option value="1">Tipo 1 — muito modesto</option>
              <option value="2">Tipo 2</option>
              <option value="3">Tipo 3 — modesto</option>
              <option value="4">Tipo 4</option>
              <option value="5" selected>Tipo 5 — médio</option>
              <option value="6">Tipo 6</option>
              <option value="7">Tipo 7 — abundante</option>
              <option value="8">Tipo 8</option>
              <option value="9">Tipo 9 — vasto</option>
              <option value="10">Tipo 10 — excepcional</option>
            </select>
          </label>
          <label data-item-option>Região consultada
            <select name="contentSource">
              <option value="all">Reinos Conhecidos + Terras Selvagens</option>
              <option value="reinos">Somente Reinos Conhecidos</option>
              <option value="terras">Somente Terras Selvagens</option>
            </select>
          </label>
          <div class="tesouro-quick-options">
            <p class="notes" data-item-option>A quantidade de objetos é sorteada com 1d20. Objetos e poderes também são sorteados; moedas e escolhas exatas ficam na aba Específicos.</p>
          </div>
        </fieldset>

        <details class="tesouro-section tesouro-section-object" data-treasure-section="object">
          <summary>Objeto</summary>
        <fieldset class="tesouro-object-options">
          <legend>Objeto</legend>
          <label>Tipo
            <select name="itemKind">
              <option value="random">Aleatório</option>
              <option value="weapon">Arma</option>
              <option value="defense">Armadura, elmo ou escudo</option>
              <option value="ring">Joia</option>
              <option value="staff">Cetro ou cajado</option>
              <option value="potion">Poção, óleo, elixir ou unguento</option>
            </select>
          </label>
          <label hidden>Objeto específico
            <select name="itemSpecific">
              <option value="">Aleatório dentro do tipo</option>
              {{#each objectChoices}}<option value="{{value}}" data-kind="{{kind}}" data-realms="{{realms}}">{{label}}</option>{{/each}}
            </select>
          </label>
          <div class="tesouro-object-pool" hidden>
            <input type="search" data-object-pool-search placeholder="Pesquisar espada, anel, elmo...">
            <div class="tesouro-object-pool-list">
              {{#each objectPoolChoices}}
              <label data-kind="{{kind}}" data-realms="{{realms}}" data-search="{{groupLabel}} {{label}}">
                <input type="checkbox" name="itemPool" value="{{poolValue}}">
                <span><strong>{{groupLabel}}</strong> — {{label}}</span>
              </label>
              {{/each}}
            </div>
            <div class="tesouro-object-pool-footer">
              <p class="notes"><strong data-object-pool-count>0 objetos selecionados.</strong> Cada opção será usada uma vez antes de começar a repetir.</p>
              <button type="button" data-action="clear-object-pool"><i class="fas fa-eraser"></i> Limpar seleção</button>
            </div>
          </div>
          <p class="notes">Escolha uma categoria ou deixe Aleatório. Para escolher um objeto exato, use Tesouros específicos.</p>
        </fieldset>
        </details>

        <details class="tesouro-section tesouro-section-magic" data-treasure-section="magic">
          <summary>Magias</summary>
        <fieldset class="tesouro-magic-options">
          <legend>Magia</legend>
          <label>Magias
            <select name="magicMode">
              <option value="random" selected>Com magia</option>
              <option value="none">Sem magia</option>
            </select>
          </label>
          <label data-magic-option>Família
            <select name="magicTradition">
              <option value="all">Todas as famílias</option>
              <option value="basic">Básicas de qualquer profissão</option>
              <option value="mage">Magos</option>
              <option value="sorcerer">Feiticeiros</option>
              <option value="ranger">Rastreadores</option>
              <option value="berserker">Berserkers — Ritos</option>
              <option value="bard">Bardos</option>
              <option value="priest">Sacerdotes</option>
            </select>
          </label>
          <label data-magic-option>Repertório
            <select name="magicRepertoire">
              <option value="all">Atual + ancestral + perdida</option>
              <option value="core">Atual</option>
              <option value="ancestral">Ancestral</option>
              <option value="lost">Perdida</option>
            </select>
          </label>
          <label data-magic-option>Escola/origem
            <select name="magicOrigin">
              <option value="">Aleatória entre todas</option>
              {{#each origins}}<option value="{{name}}" data-realms="{{realms}}" data-traditions="{{traditions}}" data-repertoires="{{repertoires}}">{{name}}</option>{{/each}}
            </select>
          </label>
          <label data-magic-option hidden>Magia específica
            <select name="specificMagic">
              <option value="">Aleatória dentro da escola/origem</option>
              {{#each magics}}<option value="{{key}}" data-realms="{{realms}}" data-origins="{{originValues}}" data-traditions="{{traditionValues}}" data-repertoires="{{repertoireValues}}">{{name}}{{repertoireSuffix}}</option>{{/each}}
            </select>
          </label>
          <div class="tesouro-callout" data-magic-option>
            <p class="notes">Magias comuns acompanham o Tipo de 1 a 10. Magias ancestrais usam os limites 11, 13, 15, 17, 19, 20, 23, 25, 27 e 30.</p>
            <p class="notes">“Com magia” permite que essa propriedade participe do sorteio. Para escolher magias e níveis exatos, use Tesouros específicos.</p>
            <p class="notes">Cetros e cajados recebem uma magia diferente em cada matriz de poder, independentemente do limite comum de duas magias.</p>
          </div>
          <div class="tesouro-edit-note"><i class="fas fa-pen-to-square"></i> O Mestre de Jogo pode modificar o que precisar no item depois que ele estiver pronto.</div>
        </fieldset>
        </details>

        <details class="tesouro-section tesouro-section-lore" data-treasure-section="lore">
          <summary>História, identidade e maldição</summary>
        <fieldset class="tesouro-lore-options">
          <legend>História, identidade e maldição</legend>
          <div class="tesouro-lore-grid">
            <label class="tesouro-check-card"><span><input type="checkbox" name="includeHistory" value="true"> Criar história para o item</span><small>Gera um nome verdadeiro e uma lenda coerente com a origem das magias.</small></label>
            <label class="tesouro-check-card"><span><input type="checkbox" name="revealHistory" value="true" disabled> Revelar história aos jogadores</span><small>Desmarcado: o Mestre recebe a história, mas o jogador vê somente o nome físico do objeto.</small></label>
            <label class="tesouro-check-card"><span><input type="checkbox" name="includeCurse" value="true"> Adicionar uma maldição</span><small>Aplica uma maldição compatível com a vertente infernal, limitada pelo Tipo do tesouro, com vínculo e tempo de afastamento próprios.</small></label>
            <label class="tesouro-check-card"><span><input type="checkbox" name="revealCurse" value="true" disabled> Revelar maldição aos jogadores</span><small>Desmarcado: a maldição permanece como segredo exclusivo do Mestre.</small></label>
            <label class="tesouro-check-card tesouro-curse-nature is-disabled">
              <span><i class="fas fa-skull"></i> Natureza do item amaldiçoado</span>
              <select name="curseNature" disabled>
                <option value="automatic">Automática</option>
                <option value="magic">Item mágico amaldiçoado</option>
                <option value="only">Somente amaldiçoado</option>
              </select>
              <small>Automática alterna entre objetos úteis corrompidos e objetos que oferecem somente a maldição.</small>
            </label>
          </div>
          <div class="tesouro-callout">
            <p class="notes">História e maldição têm visibilidade independente. O Mestre sempre recebe a versão completa.</p>
            <p class="notes">Histórias geradas são inspiradas nas referências oficiais, mas não transformam o novo objeto em artefato canônico publicado.</p>
          </div>
        </fieldset>
        </details>
      </div>

      <div class="tesouro-generation-actions">
        <button type="button" class="tesouro-primary" data-action="generate-preview"><i class="fas fa-dice"></i> Gerar prévia</button>
        <button type="button" class="tesouro-primary tesouro-chat-roll" data-action="send-roll-to-chat"><i class="fas fa-comments"></i> Enviar rolagem aos jogadores</button>
        <button type="button" class="tesouro-primary tesouro-reset-defaults" data-action="reset-defaults"><i class="fas fa-rotate-left"></i> Restaurar padrão</button>
      </div>

      {{#if hasRoll}}
      <section class="tesouro-preview">
        <h3>Resultado da rodada</h3>
        <p class="tesouro-roll-summary"><strong>Tipo {{lastRoll.type}}</strong> {{#if lastRoll.moneyOnly}} · Somente moedas{{else}} · 1d20 = <strong>{{lastRoll.die}}</strong> · {{lastRoll.count}} item(ns){{/if}}</p>
        {{#if hasPreview}}
        {{#each preview}}
        <article>
          <i class="{{icon}}"></i>
          <div>
            <strong>{{name}}</strong>
            <small>{{kindLabel}} · {{powerSummary}}</small>
            {{#if matrixSummary}}<small><i class="fas fa-gem"></i> {{matrixSummary}}</small>{{/if}}
            {{#if magics}}
            <div class="tesouro-preview-magics">
              <i class="fas fa-book-open"></i>
              {{#each magics}}<button type="button" class="tesouro-magic-link" data-magic-uuid="{{uuid}}" title="Abrir {{name}} no compêndio">{{name}} {{effect}}</button>{{#unless @last}} · {{/unless}}{{/each}}
            </div>
            {{/if}}
            {{#if lore}}
            <div class="tesouro-preview-secret"><strong><i class="fas fa-scroll"></i> História {{#unless revealHistory}}— oculta dos jogadores{{/unless}}</strong><p>{{lore.text}}</p></div>
            {{/if}}
            {{#if curse}}
            <div class="tesouro-preview-secret tesouro-preview-curse">
              <strong><i class="fas fa-skull"></i> {{curse.name}} {{#unless revealCurse}}— oculta dos jogadores{{/unless}}</strong>
              <p>{{curse.effect}}</p>
              <p><strong>Tempo de afastamento:</strong> {{curse.separationTime}}</p>
              <p><strong>Vínculo com o item:</strong> {{curse.binding.label}} — {{curse.binding.detail}}</p>
              <p><strong>Como se libertar:</strong> {{curse.binding.release}}</p>
              {{#if curse.hasNarrative}}
              <p><strong>Vertente infernal:</strong> {{curse.patronLabel}}</p>
              <p><strong>Fachada profanada:</strong> {{curse.facade.order}}</p>
              <p><strong>Sinal de heresia:</strong> {{curse.heresy}}</p>
              {{/if}}
            </div>
            {{/if}}
          </div>
        </article>
        {{/each}}
        <p class="notes tesouro-create-note">Ao confirmar, o Foundry criará uma subpasta exclusiva dentro de “Tesouros em Tagmar”.</p>
        <button type="button" class="tesouro-create" data-action="create-treasure"><i class="fas fa-folder-plus"></i> Criar este tesouro no Foundry</button>
        {{else}}
        <div class="tesouro-empty-result"><i class="fas fa-box-open"></i> Esta rodada não encontrou nenhum item mágico. Você pode rolar novamente.</div>
        {{/if}}
      </section>
      {{/if}}
    </div>
    <div class="tab tesouro-specific-tab" data-group="primary" data-tab="especificos" data-specific-panel>
      <p class="notes tesouro-exact-note"><i class="fas fa-pen-ruler"></i> Você escolhe cada valor. <strong>Zero significa sem essa propriedade.</strong> Nada é sorteado nesta aba.</p>
      <fieldset class="tesouro-manual-step">
        <legend>1. Tipo de tesouro</legend>
        <label>O que montar
          <select data-specific-field="kind">{{#each specific.kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        </label>
      </fieldset>
      {{#unless specific.isMoney}}
      <fieldset class="tesouro-manual-step">
        <legend>2. Escolher objeto</legend>
        <input type="search" data-specific-object-search placeholder="Digite para filtrar os objetos..." aria-label="Procurar objeto">
        <select data-specific-field="object" size="{{#if specific.hasObject}}1{{else}}5{{/if}}" aria-label="Objeto deste tipo">
          <option value="">Escolha o objeto...</option>
          {{#each specific.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </fieldset>
      {{/unless}}
      {{#if specific.hasObject}}
      <fieldset class="tesouro-manual-step">
        <legend>{{#if specific.isMoney}}2. Valores exatos{{else}}3. Configurar objeto{{/if}}</legend>
        <div class="tesouro-specific-grid">
          <label class="tesouro-wide">Nome <input type="text" data-specific-field="name" value="{{specific.draft.name}}" placeholder="Opcional; mantém o nome do objeto escolhido"></label>
          {{#if specific.isMoney}}
          <label>MO <input type="number" min="0" step="1" data-specific-field="mo" value="{{specific.draft.mo}}"></label>
          <label>MP <input type="number" min="0" step="1" data-specific-field="mp" value="{{specific.draft.mp}}"></label>
          <label>MC <input type="number" min="0" step="1" data-specific-field="mc" value="{{specific.draft.mc}}"></label>
          {{else}}
          <label><span>Quantidade <span class="tesouro-help" title="Cria essa quantidade de cópias idênticas do item. Cada cópia mantém todos os valores escolhidos.">(?)</span></span><input type="number" min="1" max="99" step="1" data-specific-field="quantity" value="{{specific.draft.quantity}}"></label>
          {{#if specific.hasFocus}}
          <label>Bônus mágico <input type="number" step="1" data-specific-field="bonus" value="{{specific.draft.bonus}}"></label>
          <label>Focus <input type="number" min="0" step="1" data-specific-field="focus" value="{{specific.draft.focus}}"></label>
          <label>RM adicional <input type="number" min="0" step="1" data-specific-field="resistance" value="{{specific.draft.resistance}}"></label>
          {{/if}}
          {{#if specific.hasAbsorption}}<label>ABS adicional <input type="number" min="0" step="1" data-specific-field="absorption" value="{{specific.draft.absorption}}"></label>{{/if}}
          {{#if specific.isStaff}}<label><span>Matrizes <span class="tesouro-help" title="Uma magia por matriz. Escolha a matriz ao adicionar cada poder; as demais ficam vazias.">(?)</span></span><input type="number" min="1" max="4" step="1" data-specific-field="matrices" value="{{specific.draft.matrices}}"></label>{{/if}}
          {{/if}}
        </div>
      </fieldset>
      {{#unless specific.isMoney}}
      {{#if specific.isWeapon}}
      <details class="tesouro-section tesouro-specific-detail">
        <summary>Dano, colunas e alcance <span class="tesouro-help" title="Valores base copiados da arma escolhida. Você pode alterá-los; o personagem continua calculando seus ajustes normalmente.">(?)</span></summary>
        <div class="tesouro-specific-grid">
          <label>Alcance <input type="text" data-specific-field="range" value="{{specific.draft.range}}"></label>
          <label>L <input type="number" step="1" data-specific-field="defL" value="{{specific.draft.defL}}"></label>
          <label>M <input type="number" step="1" data-specific-field="defM" value="{{specific.draft.defM}}"></label>
          <label>P <input type="number" step="1" data-specific-field="defP" value="{{specific.draft.defP}}"></label>
        </div>
        <strong class="tesouro-specific-caption">Dano base por resultado</strong>
        <div class="tesouro-specific-damage">{{#each specific.damage}}<label>{{label}}<input type="number" min="0" step="1" data-specific-field="{{field}}" value="{{value}}"></label>{{/each}}</div>
      </details>
      {{/if}}
      {{#if specific.isDefense}}
      <details class="tesouro-section tesouro-specific-detail">
        <summary>Defesa e absorção base <span class="tesouro-help" title="O bônus mágico é somado à defesa base. A ABS adicional é somada à absorção base, sem alterar o objeto original do compêndio.">(?)</span></summary>
        <div class="tesouro-specific-grid">
          <label>Categoria <select data-specific-field="defCategory">{{#each specific.defenseCategories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
          <label>Defesa base <input type="number" step="1" data-specific-field="defValue" value="{{specific.draft.defValue}}"></label>
          <label>ABS base <input type="number" min="0" step="1" data-specific-field="baseAbs" value="{{specific.draft.baseAbs}}"></label>
        </div>
      </details>
      {{/if}}
      <details class="tesouro-section tesouro-specific-detail" open>
        <summary>Magias e poderes escolhidos <span class="tesouro-help" title="Procure a magia, escolha o nível e o uso e clique em Adicionar magia. Nenhum poder é incluído automaticamente.">(?)</span></summary>
        <div class="tesouro-specific-content">
          <input type="search" data-specific-magic-search placeholder="Procurar magia ou escola..." aria-label="Procurar magia">
          <select data-specific-field="magicKey" aria-label="Magia"><option value="">Escolha uma magia...</option>{{#each specific.magics}}<option value="{{key}}" data-search="{{search}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          {{#if specific.canAddMagic}}
          <div class="tesouro-specific-grid">
            <label>Nível <select data-specific-field="magicLevel">{{#each specific.levels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
            <label>Uso <select data-specific-field="magicMode">{{#each specific.modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            {{#if specific.daily}}<label>Vezes por dia <input type="number" min="1" step="1" data-specific-field="magicUses" value="{{specific.magicUses}}"></label>{{/if}}
            {{#if specific.isStaff}}<label>Matriz <select data-specific-field="magicMatrix">{{#each specific.matrices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}
          </div>
          <button type="button" data-specific-action="add-power"><i class="fas fa-plus"></i> Adicionar magia</button>
          {{/if}}
          {{#if specific.hasPowers}}
          <ul class="tesouro-specific-powers">{{#each specific.powers}}<li><span><strong>{{name}} {{level}}</strong><small>{{usage}}{{#if matrix}} · Matriz {{matrix}}{{/if}}</small></span><button type="button" data-specific-remove-power="{{index}}" title="Remover {{name}}" aria-label="Remover {{name}}"><i class="fas fa-trash"></i></button></li>{{/each}}</ul>
          {{else}}<p class="notes">Nenhuma magia adicionada. O objeto pode ser criado sem magias.</p>{{/if}}
        </div>
      </details>
      <details class="tesouro-section tesouro-specific-detail">
        <summary>Descrição, história e maldição (opcional)</summary>
        <div class="tesouro-specific-content">
          <label>Descrição adicional <textarea data-specific-field="notes" rows="3">{{specific.draft.notes}}</textarea></label>
          <label>Nome verdadeiro <input type="text" data-specific-field="trueName" value="{{specific.draft.trueName}}"></label>
          <label>História escrita pelo mestre <textarea data-specific-field="history" rows="3">{{specific.draft.history}}</textarea></label>
          <label class="tesouro-check-line"><input type="checkbox" data-specific-field="revealHistory" {{#if specific.draft.revealHistory}}checked{{/if}}> Revelar história aos jogadores</label>
          <div class="tesouro-specific-grid">
            <label>Nome da maldição <input type="text" data-specific-field="curseName" value="{{specific.draft.curseName}}"></label>
            <label>Prazo / afastamento <input type="text" data-specific-field="curseDuration" value="{{specific.draft.curseDuration}}"></label>
          </div>
          <label>Efeito da maldição <textarea data-specific-field="curseText" rows="2">{{specific.draft.curseText}}</textarea></label>
          <label>Como se libertar <input type="text" data-specific-field="curseRelease" value="{{specific.draft.curseRelease}}"></label>
          <label class="tesouro-check-line"><input type="checkbox" data-specific-field="revealCurse" {{#if specific.draft.revealCurse}}checked{{/if}}> Revelar maldição aos jogadores</label>
          <p class="notes">História e maldição só existem se você preencher. Quando ocultas, ficam disponíveis ao mestre no resumo completo.</p>
        </div>
      </details>
      {{/unless}}
      <div class="tesouro-specific-add">
        <button type="button" class="tesouro-primary" data-specific-action="add-basket"><i class="fas fa-basket-shopping"></i> {{#if specific.isEditing}}Salvar alterações na cesta{{else}}Adicionar à cesta{{/if}}</button>
        {{#if specific.isEditing}}<button type="button" data-specific-action="cancel-edit">Cancelar edição</button>{{/if}}
      </div>
      {{/if}}
      <section class="tesouro-specific-basket">
        <h3><i class="fas fa-basket-shopping"></i> Cesta <small>{{specific.basketCount}} item(ns)</small></h3>
        {{#if specific.hasBasket}}
        <ol>{{#each specific.basket}}<li><i class="{{icon}}"></i><div><strong>{{amount}}× {{name}}</strong><small>{{kindLabel}} · {{powerSummary}}</small></div><div class="tesouro-basket-tools"><button type="button" data-specific-edit="{{basketId}}" title="Editar {{name}}" aria-label="Editar {{name}}"><i class="fas fa-pen-to-square"></i></button><button type="button" data-specific-delete="{{basketId}}" title="Remover {{name}} da cesta" aria-label="Remover {{name}} da cesta"><i class="fas fa-trash"></i></button></div></li>{{/each}}</ol>
        <p class="notes">Revise a cesta. Os itens serão criados em uma nova pasta de Tesouros em Tagmar somente ao confirmar abaixo.</p>
        <button type="button" class="tesouro-create" data-specific-action="create-basket"><i class="fas fa-folder-plus"></i> Criar esta cesta no Foundry</button>
        <button type="button" data-specific-action="clear-basket">Esvaziar cesta</button>
        {{else}}<p class="notes">A cesta está vazia. Monte um objeto ou informe as moedas e clique em Adicionar à cesta.</p>{{/if}}
      </section>
    </div>

  </section>
</form>
